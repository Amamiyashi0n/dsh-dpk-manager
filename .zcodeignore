# This directory is a workspace containing several nested repositories.
# Keep local reverse-engineering notes, unpacked applications, and runtime data
# out of any future workspace-level Git repository.

# Local investigation and runtime output
/.debug/
/.tmp/
/.cache/
/.sessions/
/.storages/

# Nested independent repositories (own .git; not part of this repo)
/dsh-dev/deepseek-harness/
/opencode/
/re-zcode/ZCode-open/
/re-zcode/zcode-cli-rs/

# Local reverse-engineering notes and extracted/vendor trees (2026-09-29 reorg)
/re-zcode/zcode-analysis/
/re-zcode/asar-extracted/
/re-zcode/artifacts/
/re-zcode/zcode-unpacked/
/re-zcode/.zcode-rs/
/re-zcode/tui-build/
/re-zcode/zcode-cli/
/ZCode-*.exe

# Generated package archives and local package-manager state
/**/*.dpk
/**/.dpk/
/**/node_modules/
/**/.pnpm-store/
/**/dist/
/**/build/
/**/target/
/**/coverage/
/**/*.tsbuildinfo

# Local credentials and diagnostics
/**/*.env
/**/*.env.*
/**/*.log
/.debug/**/credentials*.json
/re-zcode/zcode-analysis/**/credentials*.json
/**/.dsh/credentials*.json
/**/.dsh/telemetry-state.json
/.DS_Store
Thumbs.db

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
