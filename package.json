{
  "name": "dsh-dpk-manager",
  "version": "2.1.68",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "dpk": "src/cli.mjs"
  },
  "description": "DPK manager for DeepSeek Harness — pack, verify and install local DSH plugin packages (.dpk) from the Plugins-page panel and the in-session dpk tool",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./cli": {
      "default": "./src/cli.mjs"
    },
    "./client": {
      "default": "./src/client.js"
    },
    "./src/*": "./src/*",
    "./lib/*": "./src/lib/*",
    "./schemas/*": "./schemas/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schemas",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "SPEC.md",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test",
    "postpublish": "node scripts/deprecate-previous.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amamiyashi0n/dsh-dpk-manager.git",
    "directory": "dsh-dev/dpk/dpk-manager"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dpk",
    "plugin",
    "package-manager"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
